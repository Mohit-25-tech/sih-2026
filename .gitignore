# ══════════════════════════════════════════════
# VeriBorder — .gitignore
# ══════════════════════════════════════════════

# ─── Environment & Secrets ───
.env
.env.local
.env.production
.env.*.local

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
dist/
build/
*.egg
.Python
env/
venv/
.venv/

# ─── Database ───
*.db
*.sqlite3

# ─── Backend uploads & generated files ───
backend/static/uploads/
backend/static/ela/

# ─── Node / Frontend ───
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.vite/

# ─── IDE & Editor ───
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── OS ───
.DS_Store
Desktop.ini
ehthumbs.db

# ─── Logs ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
