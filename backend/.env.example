# VeriBorder Environment Configuration
# Copy this file to .env and set your Neon PostgreSQL DATABASE_URL

# Neon PostgreSQL Connection URL
# Example: postgresql://veriborder_owner:Password123@ep-cool-sample-123456.us-east-2.aws.neon.tech/veriborder?sslmode=require
# If DATABASE_URL is not set or invalid, backend automatically falls back to SQLite (sqlite:///./veriborder.db)
DATABASE_URL=

# Application Settings
SECRET_KEY=veriborder_sih26187_border_security_secret_key_2026
DEBUG=True
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
